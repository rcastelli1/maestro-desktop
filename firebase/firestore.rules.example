rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Substitua o UID abaixo pelo usuario criado em Firebase Authentication.
    // Publique a copia local como firebase/firestore.rules; esse arquivo e ignorado pelo Git.
    match /mailboxes/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid == 'COLOQUE_SEU_UID_AQUI';
    }
  }
}
